# The release signing key stays local: its password is in android/build.py, so together they would let
# anyone sign an app that installs over Orbit on the phone.
android/signing/
*.p12
*.jks
*.keystore

__pycache__/

# Isolated phone-test builds, recordings and device metadata remain local.
android/build/
android/last-audit-build.txt
dist/Orbit-Audit.apk
verification/video-audit-20260912/*
!verification/video-audit-20260912/PLAN.md
!verification/video-audit-20260912/RESULTS.md
!verification/video-audit-20260912/checks.json
verification/perf-tools/measure12-audit-*.json
/measure12-audit-*.json

# Desktop review images use synthetic data; keep bulky generated captures local.
verification/player-settings-20260912/*
!verification/player-settings-20260912/RESULTS.md
!verification/player-settings-20260912/checks.json

# Private import checkpoints and local emulator/browser output.
verification/samsung-import/

# The native Compose app's source and documentation are tracked; its local run evidence is not.
# verification/ there holds private Samsung import checkpoints and 28 MB signed APKs.
native/verification/
native/*.txt
native/*.png
native/local.properties

# Native emulator run evidence and UI-parity captures are local: large logs, a duplicate
# source snapshot and rendered screenshots. The reference extractor itself stays tracked.
verification/native-runs/
verification/ui-parity-baseline-20260915/
verification/ui-parity/*
!verification/ui-parity/reference.py
